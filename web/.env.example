# MongoDB Atlas connection string (Database Access user with readWrite on this DB only)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=leadscraper

# Random secret for signing session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Used ONLY by `npm run seed:user` to create the single admin account. Remove after seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# If you get "querySrv ECONNREFUSED": use Atlas's standard connection string instead of mongodb+srv://
# (Atlas → Connect → Drivers → choose an older driver version), e.g.
#   mongodb://USER:PASSWORD@host-00:27017,host-01:27017,host-02:27017/?tls=true&authSource=admin&replicaSet=atlas-xxxx-shard-0
