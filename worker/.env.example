MONGODB_URI=mongodb+srv://WORKER_USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=leadscraper
# Unique name per running worker instance (shows in job records for debugging)
WORKER_ID=worker-1
POLL_INTERVAL_SECONDS=3
# A running job whose heartbeat is older than this is treated as crashed and re-queued
STALE_AFTER_SECONDS=600
MAX_ATTEMPTS=3
# Identifies the crawler to website owners. Put a page/email where they can reach you.
CRAWLER_CONTACT_URL=https://example.com/crawler-info
# Step 3: website crawler (polite limits: max 5 pages per site, at least 2 s between requests to one site)
CRAWL_CONCURRENCY=10
CRAWL_DELAY_SECONDS=2.5
CRAWL_MAX_PAGES=5
CRAWL_TIMEOUT_SECONDS=15
CRAWL_RECHECK_DAYS=7
# Step 6: Google Places API (New). Leave empty to run OpenStreetMap-only.
# Restrict this key in Google Cloud to "Places API (New)" (and to the worker's IP if possible). Never commit it.
GOOGLE_PLACES_API_KEY=
# Internal monthly limits, shared by all jobs/workers (always kept at or below Google's free caps 5,000 / 10,000).
# When EITHER is reached, all Google calls stop until the next month (Pacific time) and jobs run OSM-only.
GOOGLE_TEXT_SEARCH_MONTHLY_LIMIT=4500
GOOGLE_PLACE_DETAILS_MONTHLY_LIMIT=9000
# Per search (city) caps; can be lowered, not raised.
GOOGLE_MAX_TEXT_SEARCH_PER_JOB=50
GOOGLE_MAX_DETAILS_PER_JOB=1000
GOOGLE_USAGE_TIMEZONE=America/Los_Angeles
# Phase 2a: folder for the pinned Natural Earth boundary files (downloaded + sha256-checked on first use;
# the Docker image fetches them at build time into /app/geodata). Default: worker/data/geo
# GEO_DATA_DIR=
# Phase 2b: OpenStreetMap from Geofabrik extracts (public Overpass is NOT used, not even as a fallback).
# Persistent Railway Volume mounted at /data: filtered gym files + the cached Geofabrik index.
OSM_CACHE_DIR=/data/osm
# Original .osm.pbf downloads (container disk; deleted after filtering). Empty = <system temp>/leadfinder-osm
OSM_TMP_DIR=/tmp/leadfinder-osm
# Budget for filtered files on the volume (Railway Hobby volumes max out at 5 GB) and safety margins
OSM_CACHE_MAX_BYTES=4294967296
OSM_VOLUME_MARGIN_BYTES=268435456
OSM_TMP_MARGIN_BYTES=1073741824
# A cached extract older than this is used immediately and refreshed in the background
OSM_REFRESH_DAYS=7
# Largest single extract, and most data one search may download (the whole USA is ~11 GB: search a state)
OSM_MAX_DOWNLOAD_BYTES=6442450944
OSM_MAX_JOB_DOWNLOAD_BYTES=8589934592
GEOFABRIK_INDEX_URL=https://download.geofabrik.de/index-v1.json
